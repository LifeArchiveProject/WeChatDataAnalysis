{
  "name": "wechat-data-analysis-desktop",
  "private": true,
  "version": "2.0.11",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:static": "npm --prefix ../frontend run generate && cross-env ELECTRON_START_URL=http://127.0.0.1:10392 electron .",
    "build:ui": "npm --prefix ../frontend run generate && node scripts/copy-ui.cjs",
    "build:backend": "uv sync --no-editable --extra build --extra voice-transcription && node scripts/build-backend.cjs",
    "build:icon": "node scripts/build-icon.cjs",
    "build:mac:image-helper": "node scripts/build-macos-image-helper.cjs",
    "verify:mac:native": "node scripts/verify-macos-native.cjs --arch arm64 --require-host-arch",
    "verify:mac:distribution": "node scripts/verify-macos-distribution.cjs",
    "smoke:mac": "node scripts/smoke-macos-package.cjs",
    "smoke:mac:image-scan": "node scripts/smoke-macos-package.cjs --synthetic-image-scan",
    "smoke:win": "node scripts/smoke-windows-package.cjs",
    "smoke:win:real": "node scripts/smoke-windows-real-database.cjs",
    "dist": "npm run dist:win",
    "dist:win": "npm run build:ui && npm run build:backend && npm run build:icon && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run dist:mac:arm64",
    "dist:mac:arm64": "npm run verify:mac:native && npm run build:ui && npm run build:backend && npm run build:icon && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac:arm64:release": "npm run verify:mac:native && npm run build:ui && npm run build:backend && npm run build:icon && cross-env MACOS_DISTRIBUTION_BUILD=1 electron-builder --mac dmg zip --arm64 --publish never --config.forceCodeSigning=true"
  },
  "dependencies": {
    "electron-updater": "^6.7.3",
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "com.lifearchive.wechatdataanalysis",
    "productName": "WeChatDataAnalysis",
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "icon": "build/icon.ico",
    "beforePack": "scripts/native-core-before-pack.cjs",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/after-pack.cjs",
    "afterSign": "scripts/after-sign.cjs",
    "files": [
      "src/**/*",
      "!src/wcdb-sidecar.cjs",
      "package.json",
      {
        "from": "node_modules",
        "to": "node_modules",
        "filter": [
          "electron-updater/**/*",
          "builder-util-runtime/**/*",
          "debug/**/*",
          "ms/**/*",
          "sax/**/*",
          "js-yaml/**/*",
          "argparse/**/*",
          "lazy-val/**/*",
          "lodash.escaperegexp/**/*",
          "lodash.isequal/**/*",
          "tiny-typed-emitter/**/*",
          "fs-extra/**/*",
          "graceful-fs/**/*",
          "jsonfile/**/*",
          "universalify/**/*",
          "semver/**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "resources/ui",
        "to": "ui"
      },
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "resources/signing",
        "to": "signing",
        "filter": [
          "macos-private-pki-root.cer",
          "windows-private-pki-root.cer",
          "windows-private-pki.ps1"
        ]
      },
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe",
          "ffmpeg.LICENSE",
          "ffmpeg.README",
          "LICENSE"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "forceCodeSigning": true,
      "signExts": [
        "!wechatdb_broker.exe",
        "!wechatdb_client.dll",
        "wce_integrity.pyd",
        "img_helper.dll"
      ],
      "signtoolOptions": {
        "sign": "./scripts/windows-private-pki-sign.cjs",
        "publisherName": [
          "WDA Private PKI"
        ],
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "src/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "minimumSystemVersion": "15.0",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "sign": "scripts/sign-macos.cjs"
    },
    "publish": {
      "provider": "github",
      "owner": "LifeArchiveProject",
      "repo": "WeChatDataAnalysis",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "scripts/installer-custom.nsh",
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeaderIcon": "build/installerHeaderIcon.ico"
    }
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.0.0",
    "electron-builder": "26.15.3",
    "png-to-ico": "^3.0.1"
  }
}
